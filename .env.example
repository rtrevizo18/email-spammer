PROD_ENV=FALSE

# Pacing. Run `python src/main.py` from cron every ~5 minutes.
TOTAL_AMOUNT_PER_DAY=20
MAX_SCHEDULES_PER_RUN=25
MAX_SENDS_PER_RUN=10
MIN_MINUTES_BETWEEN_SENDS=0
SCHEDULE_LEAD_MINUTES=1

# Warm-up ramp: day 1 / day 2 / day 3+ (overrides TOTAL_AMOUNT_PER_DAY when both are set).
RAMP_START_DATE=
RAMP_QUOTAS=40,80,120

# Kill switch: stop sending when exceeded (checked after >= KILL_SWITCH_MIN_SAMPLE sends).
MAX_BOUNCE_RATE=0.02
KILL_SWITCH_MIN_SAMPLE=25
